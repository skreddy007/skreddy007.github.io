---
import type { CollectionEntry } from 'astro:content';
import Icons from './Icons.astro';

interface Props {
	site: CollectionEntry<'site'>['data'];
}

const { site } = Astro.props;
const { contact, sections, social } = site;
const linkedin = social.find((item) => item.icon === 'linkedin');
---

<section id="contact" class="contact">
	<div class="section-heading text-center">
		<h2>{sections.contact}</h2>
	</div>
	<div class="container">
		<div class="contact-content">
			<div class="row">
				<div class="col-md-12">
					<div class="single-contact-box">
						<div class="contact-adress text-center">
							<div class="contact-add-head">
								<h3>{contact.name}</h3>
								<p>{contact.tagline}</p>
							</div>
							<div class="contact-add-info">
								<div class="row">
									<div class="col-xs-12 col-sm-6 single-contact-add-info">
										<h3>{contact.emailLabel}</h3>
										<p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
									</div>
									<div class="col-xs-12 col-sm-6 single-contact-add-info">
										<h3>{contact.locationLabel}</h3>
										<p>{contact.location}</p>
									</div>
								</div>
							</div>
							<div class="contact-cta">
								<a class="btn-contact btn-contact-primary" href={`mailto:${contact.email}`}>{contact.emailCta}</a>
								{
									linkedin && (
										<a class="btn-contact btn-contact-secondary" href={linkedin.href} target="_blank" rel="noopener noreferrer">
											{contact.linkedinCta}
										</a>
									)
								}
							</div>
						</div>
						<div class="hm-foot-icon text-center">
							<ul>
								{
									social.map((item) => (
										<li>
											<a href={item.href} target="_blank" rel="noopener noreferrer">
												<i aria-hidden="true">
													<Icons name={item.icon} />
												</i>
											</a>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
