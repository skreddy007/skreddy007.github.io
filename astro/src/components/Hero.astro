---
import type { CollectionEntry } from 'astro:content';

interface Props {
	site: CollectionEntry<'site'>['data'];
}

const { site } = Astro.props;

const escapeHtml = (value: string) =>
	value.replace(/[&<>"']/g, (ch) => {
		const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
		return map[ch];
	});

const heroHtml = site.hero.lines
	.map((line) => `${escapeHtml(line.text)}${line.accent ? `<span>${escapeHtml(line.accent)}</span>` : ''}`)
	.join('<br>');
---

<section id="welcome-hero" class="welcome-hero">
	<div class="container">
		<div class="row">
			<div class="col-md-12 text-center">
				<div class="header-text">
					<h2 set:html={heroHtml} />
					<p>{site.hero.tagline}</p>
					<p class="hero-subtitle">{site.hero.subtitle}</p>
					<a class="hero-cta" href={site.resume.href} target="_blank" rel="noopener noreferrer">{site.resume.label}</a>
				</div>
			</div>
		</div>
	</div>
</section>
