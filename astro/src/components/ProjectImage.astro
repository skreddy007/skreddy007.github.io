---
interface Props {
	src: string;
	webp?: string;
	alt: string;
	width?: number;
	height?: number;
}

const { src, webp, alt, width, height } = Astro.props;
const dimensions = width && height ? { width, height } : {};
---

{
	webp && webp !== src ? (
		<picture>
			<source srcset={webp} type="image/webp" />
			<img src={src} alt={alt} {...dimensions} />
		</picture>
	) : (
		<img src={src} alt={alt} {...dimensions} />
	)
}
