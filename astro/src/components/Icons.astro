---
interface Props {
	name: 'moon' | 'sun' | 'bars' | 'close' | 'linkedin' | 'github' | 'trophy' | 'up';
	class?: string;
}

const { name, class: className } = Astro.props;
---

{
	name === 'moon' && (
		<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
			<path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z" />
		</svg>
	)
}
{
	name === 'sun' && (
		<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2.2v2.2M12 19.6v2.2M2.2 12h2.2M19.6 12h2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
		</svg>
	)
}
{
	name === 'bars' && (
		<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
			<path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" />
		</svg>
	)
}
{
	name === 'close' && (
		<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
			<path d="M6.2 5.2 12 11l5.8-5.8 1 1L13 12l5.8 5.8-1 1L12 13l-5.8 5.8-1-1L11 12 5.2 6.2z" />
		</svg>
	)
}
{
	name === 'linkedin' && (
		<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
			<path d="M4.7 3.4a2.1 2.1 0 1 1-4.2 0 2.1 2.1 0 0 1 4.2 0zM.6 8.3h4V24h-4V8.3zm6.6 0h3.8v2.1h.1c.5-1 1.8-2.1 3.8-2.1 4 0 4.8 2.7 4.8 6.1V24h-4v-7.6c0-1.8 0-4.2-2.6-4.2s-2.9 2-2.9 4V24h-4V8.3z" />
		</svg>
	)
}
{
	name === 'github' && (
		<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
			<path d="M12 .5A12 12 0 0 0 8.2 23.8c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.5-1.3-1.2-1.7-1.2-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 .1.7 1.8 2.8 1.3.1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6a4.7 4.7 0 0 1 1.2-3.2 4.3 4.3 0 0 1 .1-3.2s1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2a4.3 4.3 0 0 1 .1 3.2 4.7 4.7 0 0 1 1.2 3.2c0 4.7-2.8 5.7-5.5 6 .4.3.8 1 .8 2.1v3.1c0 .3.2.7.8.6A12 12 0 0 0 12 .5z" />
		</svg>
	)
}
{
	name === 'trophy' && (
		<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
			<path d="M7 3h10v2h3v3.2a5 5 0 0 1-4.2 4.9A5.5 5.5 0 0 1 13 16.7V19h3v2H8v-2h3v-2.3a5.5 5.5 0 0 1-2.8-3.6A5 5 0 0 1 4 8.2V5h3V3zm10 4V7h1v1.2A3 3 0 0 1 17 10.9V7zM6 7v3.9A3 3 0 0 1 7 8.2V7H6z" />
		</svg>
	)
}
{
	name === 'up' && (
		<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
			<path d="M12 7.2 4.8 14.4l1.4 1.4L12 10l5.8 5.8 1.4-1.4z" />
		</svg>
	)
}
