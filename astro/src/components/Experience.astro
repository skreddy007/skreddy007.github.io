---
import type { CollectionEntry } from 'astro:content';

interface Props {
	heading: string;
	jobs: CollectionEntry<'experience'>[];
}

const { heading, jobs } = Astro.props;
---

<section id="experience" class="experience">
	<div class="section-heading text-center">
		<h2>{heading}</h2>
	</div>
	<div class="container">
		<div class="experience-content">
			<div class="main-timeline">
				<ul>
					{
						jobs.map((job) => (
							<li>
								<div class="single-timeline-box fix">
									<div class="row">
										<div class="col-md-5">
											<div class="experience-time text-right">
												<h2>{job.data.dates}</h2>
												<h3>{job.data.role}</h3>
											</div>
										</div>
										<div class="col-md-offset-1 col-md-5">
											<div class="timeline">
												<div class="timeline-content">
													<h4 class="title">
														<span>
															<i aria-hidden="true" />
														</span>
														{job.data.company}
													</h4>
													<h5>{job.data.meta}</h5>
													<div class="description">
														<ul>
															{job.data.bullets.map((bullet) => (
																<li>{bullet}</li>
															))}
														</ul>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
